{
  "name": "dsh-plugin-enhance",
  "version": "0.1.11",
  "description": "Improve the plugin management experience, making plugins easier to maintain and use.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urzz/dsh-plugin-enhance.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./remote": "./typert.remote-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "engine.js",
    "github.js",
    "client.js",
    "typert.host.js",
    "typert.remote-client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild client.source.js --bundle --preserve-symlinks --platform=browser --format=cjs --external:react --external:zod --banner:js=\"window.__ModuleLoader__.load({id:'dsh-plugin-enhance',factory(require){const module={exports:{}};\" --footer:js=\"return module.exports;}});\" --outfile=client.js && node --check index.js && node --check engine.js && node --check github.js && node --check client.js && node --check typert.host.js && node --check typert.remote-client.js",
    "test": "node --test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "zod": "^4.4.3",
    "execa": "^10.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-plugin-market": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "esbuild": "0.25.12"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": [
        "react",
        "zod"
      ]
    }
  }
}
